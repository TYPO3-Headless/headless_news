tt_content {
    news_pi1 >
    news_pi1 =< lib.contentElementWithHeader
    news_pi1 {
        fields {
            content {
                fields {
                    data = USER
                    data {
                        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
                        vendorName = GeorgRinger
                        extensionName = News
                        pluginName = Pi1
                        controller = News
                        view =< plugin.tx_news.view
                        persistence =< plugin.tx_news.persistence
                        settings =< plugin.tx_news.settings
                        settings {
                            dateFormat = TEXT
                            dateFormat = M d Y
                            dateTimeFormat = TEXT
                            dateTimeFormat = Y-m-d H:i:s
                        }
                    }
                }
            }
        }
    }

    news_newsdetail >
    news_newsdetail =< lib.contentElementWithHeader
    news_newsdetail {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsDetail
                    }
                }
            }
        }
    }

    news_newsliststicky >
    news_newsliststicky =< lib.contentElementWithHeader
    news_newsliststicky {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsListSticky
                    }
                }
            }
        }
    }

    news_newsselectedlist >
    news_newsselectedlist =< lib.contentElementWithHeader
    news_newsselectedlist {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsSelectedList
                    }
                }
            }
        }
    }

    news_newsdatemenu >
    news_newsdatemenu =< lib.contentElementWithHeader
    news_newsdatemenu {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsDateMenu
                    }
                }
            }
        }
    }

    news_newssearchform >
    news_newssearchform =< lib.contentElementWithHeader
    news_newssearchform {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsSearchForm
                    }
                }
            }
        }
    }

    news_newssearchresult >
    news_newssearchresult =< lib.contentElementWithHeader
    news_newssearchresult {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = NewsSearchResult
                    }
                }
            }
        }
    }

    news_categorylist >
    news_categorylist =< lib.contentElementWithHeader
    news_categorylist {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = CategoryList
                        controller = Category
                    }
                }
            }
        }
    }

    news_taglist >
    news_taglist =< lib.contentElementWithHeader
    news_taglist {
        fields < tt_content.news_pi1.fields
        fields {
            content {
                fields {
                    data {
                        pluginName = TagList
                        controller = Tag
                    }
                }
            }
        }
    }
}
